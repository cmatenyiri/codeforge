                <constraints nullable="false"/>
            </column>
            <column name="penalty_seconds" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="total_time_seconds" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="rank_position" type="INT"/>
            <column name="submission_count" type="INT">
