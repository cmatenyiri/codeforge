<?xml version="1.0" encoding="UTF-8"?>
<!--
  The application's tables, as the entities in com.codeforge.domain map them.

  Column types follow what Hibernate itself would generate for MySQL, because
  it validates every mapped column against them on startup: a boolean is
  BIT(1), an Instant is DATETIME(6), and a @Lob String is TEXT or LONGTEXT as its
  columnDefinition says. Booleans are spelled BIT(1) rather than BOOLEAN on
  purpose: Liquibase turns BOOLEAN into TINYINT on MySQL, which fails that
  validation.

  A Java enum is a MySQL ENUM listing every constant alphabetically. A new
  constant needs a changeset that runs
  ALTER TABLE ... MODIFY col ENUM(...) NOT NULL with the full new list, or every
  insert that uses it fails.

  Tables come in the order their foreign keys need, so each can declare its
  own inline.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ── Accounts ─────────────────────────────────────────────────────── -->

    <changeSet id="001-create-users" author="codeforge">
        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="username" type="VARCHAR(32)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_users_username"/>
            </column>
            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_users_email"/>
            </column>
            <column name="password_hash" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="ENUM('ADMIN','USER')">
                <constraints nullable="false"/>
            </column>
            <column name="avatar"
                    type="ENUM('CIPHER','CIRCUIT','FORGE','GLITCH','LATTICE','NEBULA','ORBIT','PRISM','PULSE','VERTEX')">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BIT(1)">
                <constraints nullable="false"/>
            </column>
            <column name="rating" type="DOUBLE" defaultValueNumeric="1500">
                <constraints nullable="false"/>
            </column>
            <column name="max_rating" type="DOUBLE" defaultValueNumeric="1500">
                <constraints nullable="false"/>
            </column>
            <column name="contests_attended" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- ── Problems ─────────────────────────────────────────────────────── -->

    <changeSet id="001-create-tags" author="codeforge">
        <createTable tableName="tags">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_tags_name"/>
            </column>
            <column name="slug" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_tags_slug"/>
            </column>
            <column name="created_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="001-create-problems" author="codeforge">
        <createTable tableName="problems">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="title" type="VARCHAR(160)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_problems_title"/>
            </column>
            <column name="slug" type="VARCHAR(180)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_problems_slug"/>
            </column>
            <column name="description" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="constraints_md" type="TEXT"/>
            <column name="difficulty" type="ENUM('EASY','HARD','MEDIUM')">
                <constraints nullable="false"/>
            </column>
            <column name="difficulty_rank" type="INT"/>
            <column name="published" type="BIT(1)" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="archived" type="BIT(1)">
                <constraints nullable="false"/>
            </column>
            <column name="first_published_at" type="DATETIME(6)"/>
            <column name="total_submissions" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="accepted_submissions" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT">
                <constraints foreignKeyName="fk_problems_created_by"
                             referencedTableName="users" referencedColumnNames="id"/>
            </column>
            <column name="function_name" type="VARCHAR(64)"/>
            <column name="return_type"
                    type="ENUM('BOOLEAN','DOUBLE','DOUBLE_ARRAY','INT','INT_ARRAY','INT_MATRIX','LONG','LONG_ARRAY','STRING','STRING_ARRAY')"/>
            <column name="created_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="001-create-problem-tags" author="codeforge">
        <createTable tableName="problem_tags">
            <column name="problem_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"
                             foreignKeyName="fk_problem_tags_problem"
                             referencedTableName="problems" referencedColumnNames="id"/>
            </column>
            <column name="tag_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"
                             foreignKeyName="fk_problem_tags_tag"
                             referencedTableName="tags" referencedColumnNames="id"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Problem.parameters, an ordered element collection: `position` is its index. -->
    <changeSet id="001-create-problem-parameters" author="codeforge">
        <createTable tableName="problem_parameters">
            <column name="problem_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"
                             foreignKeyName="fk_problem_parameters_problem"
                             referencedTableName="problems" referencedColumnNames="id"/>
            </column>
            <column name="position" type="INT">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="param_name" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="param_type"
                    type="ENUM('BOOLEAN','DOUBLE','DOUBLE_ARRAY','INT','INT_ARRAY','INT_MATRIX','LONG','LONG_ARRAY','STRING','STRING_ARRAY')">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="001-create-problem-examples" author="codeforge">
        <createTable tableName="problem_examples">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="problem_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_problem_examples_problem"
                             referencedTableName="problems" referencedColumnNames="id"/>
            </column>
            <column name="input_text" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="output_text" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="explanation" type="TEXT"/>
            <column name="display_order" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="001-create-problem-hints" author="codeforge">
        <createTable tableName="problem_hints">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="problem_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_problem_hints_problem"
