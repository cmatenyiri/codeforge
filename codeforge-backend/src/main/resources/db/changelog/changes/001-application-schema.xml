            <column name="content" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="display_order" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="001-create-test-cases" author="codeforge">
        <createTable tableName="test_cases">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="problem_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_test_cases_problem"
                             referencedTableName="problems" referencedColumnNames="id"/>
            </column>
            <column name="input_text" type="LONGTEXT">
                <constraints nullable="false"/>
            </column>
            <column name="expected_output" type="LONGTEXT">
                <constraints nullable="false"/>
            </column>
            <column name="hidden" type="BIT(1)">
                <constraints nullable="false"/>
            </column>
            <column name="display_order" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="001-create-editorials" author="codeforge">
        <createTable tableName="editorials">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="problem_id" type="BIGINT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_editorials_problem"
                             foreignKeyName="fk_editorials_problem"
                             referencedTableName="problems" referencedColumnNames="id"/>
            </column>
            <column name="content_md" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="time_complexity" type="VARCHAR(48)"/>
            <column name="space_complexity" type="VARCHAR(48)"/>
            <column name="created_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Editorial.solutions: one reference solution per language. -->
    <changeSet id="001-create-editorial-solutions" author="codeforge">
        <createTable tableName="editorial_solutions">
            <column name="editorial_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true"
                             foreignKeyName="fk_editorial_solutions_editorial"
                             referencedTableName="editorials" referencedColumnNames="id"/>
            </column>
            <column name="language" type="ENUM('CPP','JAVA','JAVASCRIPT','PYTHON','TYPESCRIPT')">
                <constraints nullable="false" primaryKey="true"/>
            </column>
            <column name="source_code" type="LONGTEXT">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- ── Contests ─────────────────────────────────────────────────────── -->

    <changeSet id="001-create-contests" author="codeforge">
        <createTable tableName="contests">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="title" type="VARCHAR(160)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_contests_title"/>
            </column>
            <column name="slug" type="VARCHAR(180)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_contests_slug"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="type" type="ENUM('BIWEEKLY','SPECIAL','WEEKLY')">
                <constraints nullable="false"/>
            </column>
            <column name="starts_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="duration_minutes" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="ends_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="published" type="BIT(1)">
                <constraints nullable="false"/>
            </column>
            <column name="rated" type="BIT(1)">
                <constraints nullable="false"/>
            </column>
            <column name="unrated_reason" type="VARCHAR(500)"/>
            <column name="sealed_at" type="DATETIME(6)"/>
            <column name="problems_released_at" type="DATETIME(6)"/>
            <column name="ratings_applied_at" type="DATETIME(6)"/>
            <column name="rejudge_state" type="ENUM('COMPLETED','FAILED','NONE','RUNNING')">
                <constraints nullable="false"/>
            </column>
            <column name="rejudge_started_at" type="DATETIME(6)"/>
            <column name="rejudge_finished_at" type="DATETIME(6)"/>
            <column name="rejudge_total" type="INT"/>
            <column name="rejudge_done" type="INT"/>
            <column name="rejudge_error" type="VARCHAR(500)"/>
            <column name="created_by" type="BIGINT">
                <constraints foreignKeyName="fk_contests_created_by"
                             referencedTableName="users" referencedColumnNames="id"/>
            </column>
            <column name="created_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="contests" indexName="ix_contests_starts_at">
            <column name="starts_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="001-create-contest-problems" author="codeforge">
        <createTable tableName="contest_problems">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="contest_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_contest_problems_contest"
                             referencedTableName="contests" referencedColumnNames="id"/>
            </column>
            <column name="problem_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_contest_problems_problem"
                             referencedTableName="problems" referencedColumnNames="id"/>
            </column>
            <column name="position" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="points" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="problem_snapshot" type="LONGTEXT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="contest_problems" constraintName="uk_contest_problem_position"
                             columnNames="contest_id, position"/>
        <addUniqueConstraint tableName="contest_problems" constraintName="uk_contest_problem_problem"
                             columnNames="contest_id, problem_id"/>
    </changeSet>

    <!-- ── Interviews ───────────────────────────────────────────────────── -->

    <changeSet id="001-create-interviews" author="codeforge">
        <createTable tableName="interviews">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_interviews_user"
                             referencedTableName="users" referencedColumnNames="id"/>
            </column>
            <column name="format" type="ENUM('HARD','STANDARD','WARM_UP')">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="ENUM('ABANDONED','COMPLETED','IN_PROGRESS')">
                <constraints nullable="false"/>
            </column>
            <column name="duration_minutes" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="started_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="ended_at" type="DATETIME(6)"/>
            <column name="score" type="INT"/>
            <column name="outcome" type="ENUM('NO_SOLVE','PARTIAL','SOLID','STRONG')"/>
            <column name="used_outside_help" type="BIT(1)"/>
            <column name="created_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="interviews" indexName="ix_interviews_user">
            <column name="user_id"/>
        </createIndex>
    </changeSet>

    <!-- ── Submissions ──────────────────────────────────────────────────── -->

    <changeSet id="001-create-submissions" author="codeforge">
        <createTable tableName="submissions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_submissions_user"
                             referencedTableName="users" referencedColumnNames="id"/>
            </column>
            <column name="problem_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_submissions_problem"
                             referencedTableName="problems" referencedColumnNames="id"/>
            </column>
            <column name="interview_id" type="BIGINT">
                <constraints foreignKeyName="fk_submissions_interview"
                             referencedTableName="interviews" referencedColumnNames="id"/>
            </column>
            <column name="contest_id" type="BIGINT">
                <constraints foreignKeyName="fk_submissions_contest"
                             referencedTableName="contests" referencedColumnNames="id"/>
            </column>
            <column name="contest_problem_id" type="BIGINT">
                <constraints foreignKeyName="fk_submissions_contest_problem"
                             referencedTableName="contest_problems" referencedColumnNames="id"/>
            </column>
            <column name="counted_in_contest" type="BIT(1)">
                <constraints nullable="false"/>
            </column>
            <column name="contest_seconds" type="BIGINT"/>
            <column name="language" type="ENUM('CPP','JAVA','JAVASCRIPT','PYTHON','TYPESCRIPT')">
                <constraints nullable="false"/>
            </column>
            <column name="source_code" type="LONGTEXT">
                <constraints nullable="false"/>
            </column>
            <column name="status"
                    type="ENUM('ACCEPTED','COMPILE_ERROR','INTERNAL_ERROR','MEMORY_LIMIT_EXCEEDED','PENDING','RUNNING','RUNTIME_ERROR','TIME_LIMIT_EXCEEDED','WRONG_ANSWER')">
                <constraints nullable="false"/>
            </column>
            <column name="runtime_ms" type="INT"/>
            <column name="memory_kb" type="INT"/>
            <column name="passed_tests" type="INT"/>
            <column name="total_tests" type="INT"/>
            <column name="failure_message" type="TEXT"/>
            <column name="created_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="submissions" indexName="ix_submissions_user">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="submissions" indexName="ix_submissions_problem">
            <column name="problem_id"/>
        </createIndex>
        <createIndex tableName="submissions" indexName="ix_submissions_contest">
            <column name="contest_id"/>
        </createIndex>
        <createIndex tableName="submissions" indexName="ix_submissions_user_created">
            <column name="user_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="001-create-interview-problems" author="codeforge">
        <createTable tableName="interview_problems">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="interview_id" type="BIGINT">
