    <!-- ── Contest results ──────────────────────────────────────────────── -->

    <changeSet id="001-create-contest-participations" author="codeforge">
        <createTable tableName="contest_participations">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="contest_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_contest_participations_contest"
                             referencedTableName="contests" referencedColumnNames="id"/>
            </column>
            <column name="user_id" type="BIGINT">
